{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/protocol/athena.v1.schema.json",
  "title": "Athena engine protocol v1",
  "description": "Newline-delimited JSON messages exchanged between a local Athena UI and `athena engine`. This file is the contract: internal/transport/stdio has a test that fails when the Go structs or the emitted type names drift from it.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["version", "requestId", "type"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "engine.hello",
            "session.submit",
            "session.cancel",
            "session.reset",
            "plan.approve",
            "plan.reject",
            "model.list",
            "model.select",
            "provider.list",
            "provider.connect",
            "provider.oauth.start"
          ]
        },
        "input": { "type": "string", "description": "Required for session.submit." },
        "turnId": { "type": "string", "description": "Required for session.cancel." },
        "planId": { "type": "string", "description": "Required for plan.approve and plan.reject." },
        "providerId": { "type": "string", "description": "Required for model.select and provider.oauth.start." },
        "model": { "type": "string", "description": "Required for model.select." },
        "connection": { "$ref": "#/$defs/connection", "description": "Required for provider.connect." }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "base_url": { "type": "string" },
        "api_key_env": { "type": "string" },
        "api_key": { "type": "string", "description": "Stored in provider-credentials.json when supplied." },
        "chat_model": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["phase", "message"],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "description": "What kind of work this step is.",
          "enum": [
            "working",
            "retrieving",
            "planning",
            "reading",
            "searching",
            "embedding",
            "provider_wait",
            "validating",
            "approval",
            "executing",
            "observing",
            "verifying",
            "replanning",
            "completed"
          ]
        },
        "message": { "type": "string", "description": "Human-readable fallback line. Clients render the typed fields; they must not parse this." },
        "state": {
          "description": "Step lifecycle. Absent on informational sub-notifications that are not themselves a step.",
          "enum": ["started", "succeeded", "failed"]
        },
        "tool": { "type": "string", "description": "The read tool or action type this step ran, when it ran one." },
        "target": { "type": "string", "description": "What the step acted on: a vault path, a note reference, or a query." },
        "run_id": { "type": "string" },
        "step": { "type": "integer" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "description": "Engine-generated display text. Render this instead of switching on type." },
        "type": { "type": "string" },
        "note_id": { "type": "integer" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "section": { "type": "string" },
        "expected_content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "folder": { "type": "string" },
        "include_children": { "type": "boolean" },
        "color": { "type": "string", "description": "Orb color as #RRGGBB." },
        "node_size_multiplier": { "type": "number" },
        "path": { "type": "string" },
        "new_folder": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "folders": { "type": "array", "items": { "type": "string" } },
        "done": { "type": "boolean" },
        "isbn": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "genres": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modelOption": {
      "type": "object",
      "required": ["providerId", "providerName", "model", "current"],
      "additionalProperties": false,
      "properties": {
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "model": { "type": "string" },
        "current": { "type": "boolean" }
      }
    },
    "providerPreset": {
      "type": "object",
      "required": ["id", "label", "detail", "type", "auth", "available"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "detail": { "type": "string" },
        "type": { "type": "string" },
        "auth": { "enum": ["oauth", "api_key", "none"] },
        "name": { "type": "string" },
        "base_url": { "type": "string" },
        "api_key_env": { "type": "string" },
        "chat_model": { "type": "string" },
        "available": { "type": "boolean" },
        "unavailable": { "type": "string" }
      }
    },
    "ledgerRecord": {
      "type": "object",
      "required": ["action", "status"],
      "additionalProperties": false,
      "description": "One verified action outcome. This is what the vault did, not what the model said it did.",
      "properties": {
        "action": { "type": "string" },
        "target": { "type": "string" },
        "status": { "enum": ["succeeded", "failed"] },
        "message": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "required": ["version", "type"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "requestId": { "type": "string" },
        "type": {
          "enum": [
            "engine.ready",
            "turn.started",
            "turn.completed",
            "turn.cancelled",
            "turn.failed",
            "turn.error",
            "turn.cancellation_requested",
            "activity",
            "response",
            "plan.ready",
            "plan.approved",
            "plan.rejected",
            "model.options",
            "model.selected",
            "provider.presets",
            "provider.connected",
            "provider.oauth.started",
            "provider.oauth.progress",
            "provider.oauth.cancelled",
            "session.reset",
            "error"
          ]
        },
        "turnId": { "type": "string" },
        "planId": { "type": "string" },
        "message": { "type": "string" },
        "error": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "activity": { "$ref": "#/$defs/activity" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "models": { "type": "array", "items": { "$ref": "#/$defs/modelOption" } },
        "ledger": { "type": "array", "items": { "$ref": "#/$defs/ledgerRecord" } },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/providerPreset" } }
      }
    }
  }
}
